# OpenAI — powers /api/chat and /api/tts
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6-terra.
# gpt-5.6-sol = strongest, gpt-5.6-luna = fastest and cheapest.
OPENAI_MODEL=

# Daily catalogue refresh (/api/refresh-kb, called by the Vercel cron).
# Vercel sends CRON_SECRET as a Bearer token on cron invocations; the route
# rejects anything else. The hook URL comes from
# Vercel → Settings → Git → Deploy Hooks.
CRON_SECRET=
VERCEL_DEPLOY_HOOK_URL=
